# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/learnhub

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — choose ONE: console | gmail | resend | sendgrid
#   console  : prints emails to the server log (default for local dev)
#   gmail    : sends via Gmail SMTP using an App Password (NOT your real password)
#              https://myaccount.google.com/apppasswords  — requires 2FA enabled
#   resend   : https://resend.com (recommended for production, free tier: 3k/mo)
#   sendgrid : https://sendgrid.com (free tier: 100/day)
#
# IMPORTANT: if EMAIL_PROVIDER is set to gmail/resend/sendgrid but the credentials
# below are missing, the mailer silently falls back to "console" (logs the email).
# That's why verification/reset links sometimes only appear in the server log —
# set the provider AND fill the matching key.
EMAIL_PROVIDER=console

# Gmail (only used when EMAIL_PROVIDER=gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Power Automate webhook URL (optional — paste the HTTP POST URL from your PA flow)
# When set, a notification is fired to Power Automate on every new user registration
POWER_AUTOMATE_WEBHOOK_URL=

# Resend (only used when EMAIL_PROVIDER=resend)
# Verified sender address. Free Resend accounts can use onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=LearnHub <onboarding@resend.dev>

# SendGrid (only used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@learnhub.dev

# Google Gemini — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Comma-separated fallback keys — used when primary key hits quota
GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Encryption for sensitive at-rest data (32-byte hex)
COOKIE_ENC_KEY=replace_with_32_byte_random_hex

# OneCompiler — code execution API (Module 5). Get one at https://onecompiler.com/apis
ONECOMPILER_API_KEY=oc_xxx_xxx_xxx
