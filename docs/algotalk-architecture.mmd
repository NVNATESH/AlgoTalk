flowchart TB

%% =====================
%% Header
%% =====================
H[ALGOTALK<br/>AI-Powered Collaborative Learning & Competitive Programming Platform Architecture]

%% =====================
%% Tier 1 Frontend
%% =====================
subgraph FE[TIER 1 FRONTEND]
direction LR
FE1[Dashboard<br/>Progress, heatmaps, goals]
FE2[Problem Solver UI<br/>Monaco + review panel]
FE3[Interview Workspace<br/>Code + communication flow]
FE4[Group Challenges UI<br/>Leaderboards, meets]
FE5[Rooms UI<br/>Yjs editor + voice controls]
FE6[Integrations UI<br/>LeetCode, CF, CC, GFG, etc.]
end

%% =====================
%% Auth Layer
%% =====================
subgraph AUTH[AUTH LAYER]
direction LR
A1[JWT Access/Refresh]
A2[Role-Based Access Control<br/>user, moderator, admin]
A3[Zod Request Validation]
A4[Rate Limiting + Helmet + CORS]
A5[Session & Token Rotation]
end

%% =====================
%% Tier 2 Backend
%% =====================
subgraph BE[TIER 2 BACKEND API]
direction LR
B1[Auth & Profile Services]
B2[Goals & Learning Services]
B3[Problems & Submission Services]
B4[Contests & Reports Services]
B5[Interview Services]
B6[Groups, Rooms & Meets Services]
B7[Notifications & Admin Services]
end

%% =====================
%% AI / Intelligence
%% =====================
subgraph AI[AI INTELLIGENCE LAYER]
direction LR
AI1[Roadmap Generation]
AI2[Guided Hints / No Full-Solution Mode]
AI3[Code Review & Line-Level Feedback]
AI4[Contest Post-Mortem + Upsolving Guidance]
AI5[Mock Interview Evaluation<br/>code + communication]
AI6[Cross-Platform Recommendation Engine]
AI7[Weak-Area Detection & Skill Gap Analytics]
end

%% =====================
%% Data + Realtime/External
%% =====================
subgraph DB[DATABASE LAYER]
direction LR
D1[(MongoDB + Mongoose Models)]
D2[Goals, Submissions, Reviews]
D3[Groups, Rooms, Notifications, Interviews]
D4[Contest Reports + Integrations Data]
end

subgraph EXT[REALTIME EXTERNAL INTEGRATIONS]
direction LR
E1[Yjs WebSocket Sync]
E2[WebRTC Voice Signaling]
E3[Notify WebSocket Push]
E4[Platform Extractors<br/>LeetCode, Codeforces, CodeChef, AtCoder, HackerRank, HackerEarth, GFG]
E5[Browser Extension Capture]
end

%% =====================
%% Flow
%% =====================
H --> FE
FE -->|JWT / API calls| AUTH
AUTH -->|Verified request| BE
BE -->|AI calls| AI
BE -->|Read / Write| DB
BE -->|Events / Sync| EXT
AI -->|Insights & recommendations| BE
EXT -->|Activity data| BE

%% =====================
%% Legend
%% =====================
subgraph L[LEGEND]
direction TB
L1[Frontend Layer]
L2[Security Layer]
L3[Backend API Layer]
L4[AI / Intelligence Layer]
L5[Database Layer]
L6[Realtime / Integration Layer]
end

